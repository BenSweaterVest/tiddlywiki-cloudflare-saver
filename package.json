{
  "name": "tiddlywiki-cloudflare-saver",
  "version": "2.0.0",
  "description": "Save a single-file TiddlyWiki to GitHub through your own free Cloudflare Worker",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check:build": "node scripts/build.js --check",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run check:build && npm test"
  },
  "keywords": [
    "tiddlywiki",
    "tiddlywiki-plugin",
    "saver",
    "cloudflare",
    "cloudflare-workers",
    "github",
    "serverless",
    "wiki"
  ],
  "author": "BenSweaterVest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenSweaterVest/tiddlywiki-cloudflare-saver.git"
  },
  "bugs": {
    "url": "https://github.com/BenSweaterVest/tiddlywiki-cloudflare-saver/issues"
  },
  "homepage": "https://github.com/BenSweaterVest/tiddlywiki-cloudflare-saver#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "playwright": "1.63.0",
    "tiddlywiki": "^5.4.1"
  },
  "private": true
}
